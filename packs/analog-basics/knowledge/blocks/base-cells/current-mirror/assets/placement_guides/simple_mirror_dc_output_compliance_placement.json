{
  "cell_name": "current-mirror",
  "description": "Topology-aware placement for current-mirror (mirror)",
  "grid_size": {
    "cols": 3,
    "rows": 5
  },
  "placements": {
    "MREF": {
      "type": "nmos",
      "col": 0,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    },
    "MOUT": {
      "type": "nmos",
      "col": 2,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    }
  },
  "internal_nets": {
    "ref_drain": [
      "MREF__port__D",
      "MREF__port__G",
      "MOUT__port__G"
    ]
  },
  "external_ports": {
    "ref_drain": {
      "connects_to": [
        "MREF__port__D",
        "MREF__port__G",
        "MOUT__port__G"
      ],
      "direction": "input",
      "side": "left",
      "anchor": "core.ref"
    },
    "vss": {
      "connects_to": [
        "MREF__port__S",
        "MOUT__port__D",
        "MOUT__port__S"
      ],
      "direction": "power",
      "side": "bottom",
      "anchor": "core.supply"
    }
  },
  "macros": {
    "core": {
      "type": "base_cell",
      "cell_name": "current-mirror",
      "footprint": "current-mirror",
      "template": "dual_device_horizontal_3col",
      "origin": {
        "col": 0,
        "row": 0
      },
      "size": {
        "cols": 3,
        "rows": 2
      },
      "anchors": {
        "ref": {
          "side": "left",
          "offset": 0
        },
        "out": {
          "side": "right",
          "offset": 2
        },
        "supply": {
          "side": "bottom",
          "offset": 1
        }
      },
      "bands": [
        "nmos"
      ],
      "symmetry": {
        "type": "mirror-x",
        "center_col": 1,
        "center_gap": 1
      },
      "children": [
        "MREF",
        "MOUT"
      ],
      "hierarchy": {
        "child_cell": "current-mirror",
        "child_view": "schematic"
      }
    }
  },
  "anchors": {
    "ref": {
      "owner": "core",
      "anchor": "ref"
    },
    "out": {
      "owner": "core",
      "anchor": "out"
    },
    "supply": {
      "owner": "core",
      "anchor": "supply"
    }
  }
}