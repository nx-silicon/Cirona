{
  "cell_name": "differential-pair",
  "description": "Topology-aware placement for differential-pair (differential_pair)",
  "grid_size": {
    "cols": 7,
    "rows": 5
  },
  "placements": {
    "M1": {
      "type": "nmos",
      "col": 0,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    },
    "M2": {
      "type": "nmos",
      "col": 2,
      "row": 4,
      "orientation": "normal",
      "flip_h": true
    },
    "RLP": {
      "type": "resistor",
      "col": 4,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    },
    "RLN": {
      "type": "resistor",
      "col": 6,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    }
  },
  "internal_nets": {
    "tail": [
      "M1__port__S",
      "M2__port__S"
    ]
  },
  "external_ports": {
    "vdd": {
      "connects_to": [
        "RLP__port__T",
        "RLN__port__T"
      ],
      "direction": "power",
      "side": "top"
    },
    "loadp": {
      "connects_to": "RLP__port__B",
      "direction": "input",
      "side": "left"
    },
    "loadn": {
      "connects_to": "RLN__port__B",
      "direction": "input",
      "side": "left"
    },
    "drain_p": {
      "connects_to": "M1__port__D",
      "direction": "output",
      "side": "right",
      "anchor": "core.outp"
    },
    "vss": {
      "connects_to": [
        "M1__port__G",
        "M2__port__G"
      ],
      "direction": "power",
      "side": "bottom"
    },
    "drain_n": {
      "connects_to": "M2__port__D",
      "direction": "output",
      "side": "right",
      "anchor": "core.outn"
    }
  },
  "macros": {
    "core": {
      "type": "base_cell",
      "cell_name": "differential-pair",
      "footprint": "differential-pair",
      "template": "dual_device_horizontal_3col",
      "origin": {
        "col": 0,
        "row": 0
      },
      "size": {
        "cols": 3,
        "rows": 2
      },
      "anchors": {
        "vinp": {
          "side": "left",
          "offset": 0
        },
        "vinn": {
          "side": "right",
          "offset": 0
        },
        "tail": {
          "side": "bottom",
          "offset": 1
        },
        "outp": {
          "side": "top",
          "offset": 0
        },
        "outn": {
          "side": "top",
          "offset": 2
        }
      },
      "bands": [
        "signal",
        "nmos"
      ],
      "symmetry": {
        "type": "mirror-x",
        "center_col": 1,
        "center_gap": 1
      },
      "children": [
        "M1",
        "M2",
        "RLP",
        "RLN"
      ],
      "hierarchy": {
        "child_cell": "differential-pair",
        "child_view": "schematic"
      }
    }
  },
  "anchors": {
    "vinp": {
      "owner": "core",
      "anchor": "vinp"
    },
    "vinn": {
      "owner": "core",
      "anchor": "vinn"
    },
    "tail": {
      "owner": "core",
      "anchor": "tail"
    },
    "outp": {
      "owner": "core",
      "anchor": "outp"
    },
    "outn": {
      "owner": "core",
      "anchor": "outn"
    }
  }
}