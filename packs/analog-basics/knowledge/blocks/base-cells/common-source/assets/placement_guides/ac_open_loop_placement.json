{
  "cell_name": "common-source",
  "description": "Topology-aware placement for common-source (single_branch)",
  "grid_size": {
    "cols": 5,
    "rows": 5
  },
  "placements": {
    "M1": {
      "type": "nmos",
      "col": 1,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    },
    "RD": {
      "type": "resistor",
      "col": 4,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    }
  },
  "internal_nets": {
    "out": [
      "RD__port__B",
      "M1__port__D"
    ]
  },
  "external_ports": {
    "vdd": {
      "connects_to": [
        "RD__port__T"
      ],
      "direction": "power",
      "side": "top"
    },
    "out": {
      "connects_to": [
        "RD__port__B",
        "M1__port__D"
      ],
      "direction": "output",
      "side": "right"
    },
    "gate": {
      "connects_to": "M1__port__G",
      "direction": "input",
      "side": "left"
    },
    "source": {
      "connects_to": "M1__port__S",
      "direction": "input",
      "side": "left"
    }
  },
  "macros": {},
  "anchors": {}
}