      "col": 0,
      "row": 0,
      "orientation": "normal",
      "flip_h": false
    },
    "M4": {
      "type": "pmos",
      "col": 2,
      "row": 0,
      "orientation": "normal",
      "flip_h": false
    },
    "M1": {
      "type": "nmos",
      "col": 0,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    },
    "M2": {
      "type": "nmos",
      "col": 2,
      "row": 4,
      "orientation": "normal",
