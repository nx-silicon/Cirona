{
  "cell_name": "cmfb",
  "description": "User-edited placement for cmfb",
  "grid_size": {
    "cols": 10,
    "rows": 8
  },
  "placements": {
    "MMCM1": {
      "type": "nmos",
      "col": 0,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    },
    "MMCM2": {
      "type": "nmos",
      "col": 2,
      "row": 4,
      "orientation": "normal",
      "flip_h": true
    },
    "MMCM3": {
      "type": "pmos",
      "col": 0,
      "row": 1,
      "orientation": "normal",
      "flip_h": true
    },
    "MMCM4": {
      "type": "pmos",
      "col": 2,
      "row": 1,
      "orientation": "normal",
      "flip_h": false
    },
    "MPOUTN": {
      "type": "pmos",
      "col": 4,
      "row": 0,
      "orientation": "normal",
      "flip_h": false
    },
    "MPOUTP": {
      "type": "pmos",
      "col": 6,
      "row": 0,
      "orientation": "normal",
      "flip_h": false
    },
    "RCM1": {
      "type": "resistor",
      "col": 6,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    },
    "RCM2": {
      "type": "resistor",
      "col": 5,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    },
    "RCTRL_SEED": {
      "type": "resistor",
      "col": 2,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    }
  },
  "internal_nets": {
    "ncm_mirror": [
      "MMCM1__port__D",
      "MMCM3__port__G",
      "MMCM3__port__D",
      "MMCM4__port__G"
    ],
    "ncm_tail": [
      "MMCM1__port__S",
      "MMCM2__port__S"
    ],
    "outn": [
      "MPOUTN__port__D",
      "RCM2__port__T"
    ],
    "outp": [
      "MPOUTP__port__D",
      "RCM1__port__T"
    ],
    "vcm_sense": [
      "RCM1__port__B",
      "RCM2__port__B",
      "MMCM1__port__G"
    ],
    "vcmfb_ctrl": [
      "MPOUTP__port__G",
      "MPOUTN__port__G",
      "RCTRL_SEED__port__T",
      "MMCM2__port__D",
      "MMCM4__port__D"
    ],
    "vcmref": [
      "RCTRL_SEED__port__B",
      "MMCM2__port__G"
    ]
  },
  "external_ports": {
    "outn": {
      "connects_to": [
        "MPOUTN__port__D",
        "RCM2__port__T"
      ],
      "direction": "output",
      "side": "right"
    },
    "outp": {
      "connects_to": [
        "MPOUTP__port__D",
        "RCM1__port__T"
      ],
      "direction": "output",
      "side": "right"
    },
    "vcmref": {
      "connects_to": [
        "RCTRL_SEED__port__B",
        "MMCM2__port__G"
      ],
      "direction": "input",
      "side": "left"
    },
    "vdd": {
      "connects_to": [
        "MPOUTP__port__S",
        "MPOUTN__port__S",
        "MMCM3__port__S",
        "MMCM4__port__S"
      ],
      "direction": "power",
      "side": "top"
    }
  }
}