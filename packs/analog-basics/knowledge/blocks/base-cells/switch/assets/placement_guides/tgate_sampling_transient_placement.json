{
  "cell_name": "sampling-switch",
  "description": "Topology-aware placement for sampling-switch (simple_switch)",
  "grid_size": {
    "cols": 5,
    "rows": 5
  },
  "placements": {
    "MP": {
      "type": "pmos",
      "col": 1,
      "row": 1,
      "orientation": "normal",
      "flip_h": false
    },
    "MN": {
      "type": "nmos",
      "col": 1,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    },
    "CS": {
      "type": "capacitor",
      "col": 4,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    }
  },
  "internal_nets": {
    "vin": [
      "MN__port__D",
      "MP__port__D"
    ],
    "hold": [
      "MN__port__S",
      "MP__port__S",
      "CS__port__T"
    ]
  },
  "external_ports": {
    "vin": {
      "connects_to": [
        "MN__port__D",
        "MP__port__D"
      ],
      "direction": "input",
      "side": "right"
    },
    "clk": {
      "connects_to": "MN__port__G",
      "direction": "input",
      "side": "left"
    },
    "clkb": {
      "connects_to": "MP__port__G",
      "direction": "input",
      "side": "left"
    },
    "vss": {
      "connects_to": [
        "CS__port__B"
      ],
      "direction": "power",
      "side": "bottom"
    }
  },
  "macros": {},
  "anchors": {}
}