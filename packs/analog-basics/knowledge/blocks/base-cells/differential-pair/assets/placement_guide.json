{
  "cell_name": "differential-pair",
  "description": "User-edited placement for differential-pair",
  "grid_size": {
    "cols": 10,
    "rows": 8
  },
  "placements": {
    "M1": {
      "type": "nmos",
      "col": 0,
      "row": 4,
      "orientation": "normal",
      "flip_h": false
    },
    "M2": {
      "type": "nmos",
      "col": 2,
      "row": 4,
      "orientation": "normal",
      "flip_h": true
    },
    "RLN": {
      "type": "resistor",
      "col": 2,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    },
    "RLP": {
      "type": "resistor",
      "col": 1,
      "row": 2,
      "orientation": "normal",
      "flip_h": false
    }
  },
  "internal_nets": {
    "tail": [
      "M1__port__S",
      "M2__port__S"
    ]
  },
  "external_ports": {
    "drain_n": {
      "anchor": "core.outn",
      "connects_to": "M2__port__D",
      "direction": "output",
      "side": "right"
    },
    "drain_p": {
      "anchor": "core.outp",
      "connects_to": "M1__port__D",
      "direction": "output",
      "side": "right"
    },
    "loadn": {
      "connects_to": "RLN__port__B",
      "direction": "input",
      "side": "left"
    },
    "loadp": {
      "connects_to": "RLP__port__B",
      "direction": "input",
      "side": "left"
    },
    "vdd": {
      "connects_to": [
        "RLP__port__T",
        "RLN__port__T"
      ],
      "direction": "power",
      "side": "top"
    },
    "vss": {
      "connects_to": [
        "M1__port__G",
        "M2__port__G"
      ],
      "direction": "power",
      "side": "bottom"
    }
  }
}